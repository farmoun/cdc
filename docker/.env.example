# =============================================================
# CDC 同步栈配置 —— 复制为 .env 并按实际填写（尤其是两个密码）
#   cp .env.example .env && vim .env
# 假设：本 docker 栈部署在 ClickHouse 所在的 B 服(40.160.14.146)
# =============================================================

# ---- 远程 MySQL（A 服务器）----
MYSQL_HOST=147.135.76.13
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=改成你的MySQL密码

# ---- ClickHouse（B 服务器宿主机原生安装）----
# 容器通过 host.docker.internal 访问宿主机 CK（compose 已配 host-gateway）
# 若不通，可改成 B 服的 IP：40.160.14.146。CK 需监听 0.0.0.0
CK_HOST=host.docker.internal
CK_HTTP_PORT=8123
CK_USER=default
CK_PASSWORD=改成你的CK密码
CK_DATABASE=yibuapi

# ---- Kafka broker 地址（单节点版）----
# 原生 CK(与本栈同机) 用宿主机映射端口访问 Kafka
KAFKA_BROKER_FOR_CK=localhost:9094
# 容器内组件（Connect history / 监控 lag）用 docker 内部地址
KAFKA_INTERNAL_BROKER=kafka:9092
# Kafka 对宿主机广播的地址：CK 与本栈同机时用 localhost
KAFKA_ADVERTISED_HOST=localhost
#
# 若改用 HA 三节点(docker-compose.ha.yml)，把上面两行改为：
#   KAFKA_BROKER_FOR_CK=localhost:9094,localhost:9095,localhost:9096
#   KAFKA_INTERNAL_BROKER=kafka1:9092,kafka2:9092,kafka3:9092

# ---- 容器内服务地址（不用改）----
SCHEMA_REGISTRY_URL=http://schema-registry:8081
CONNECT_URL=http://connect:8083

# ---- Debezium 连接器 ----
DBZ_CONNECTOR_NAME=yibuapi-connector
DBZ_SERVER_NAME=yibuapi
DBZ_SERVER_ID=1001
DBZ_TASKS_MAX=1
# snapshot.mode: schema_only=不做阻塞式全量,只读schema+从当前位点增量;历史数据用"增量快照"(可断点续传)回填
# 大表(如2.6亿行的logs)必须用这个,否则普通快照崩了要从头重来
DBZ_SNAPSHOT_MODE=when_needed
DBZ_HISTORY_TOPIC=schema-changes.yibuapi

# ---- 监控面板宿主机端口 ----
MONITOR_PORT=8080

# ---- 大消息上限（logs/图片base64等大字段用；默认 64MB）----
# 若单条记录更大（如高清图 base64），调大这个数（单位字节，如 128MB=134217728）
KAFKA_MAX_MESSAGE_BYTES=67108864
